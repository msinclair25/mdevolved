{
  "name": "owd-platform",
  "version": "1.0.0-alpha.3",
  "private": true,
  "description": "Owner-controlled continuity for Obsidian and independent AI agents, with cited handoffs, Decisions, and encrypted recovery.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Private metadata, passkey/session records, vault indexes, audit events, and authorization policy for this one-owner deployment."
      },
      "VAULT_STORAGE": {
        "description": "Immutable materialized Markdown objects, encrypted age backups, and short-lived isolated restore staging for this one-owner deployment."
      },
      "OAUTH_KV": {
        "description": "Dedicated short-lived OAuth protocol storage for remote MCP clients; vault authorization remains authoritative in D1."
      }
    }
  },
  "scripts": {
    "acceptance:agent:production": "node scripts/production-agent-acceptance.mjs",
    "build": "pnpm package:plugin && pnpm build:web",
    "build:marketing": "pnpm --filter @owd/marketing build",
    "build:plugin": "pnpm --filter @owd/obsidian-plugin build",
    "build:web": "pnpm --filter @owd/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm types:check && pnpm policy:check && pnpm upstream:config:check && pnpm release:check",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build && pnpm db:migrations:apply && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run --outdir dist/worker",
    "deploy:marketing": "pnpm --filter @owd/marketing deploy",
    "deploy:marketing:dry-run": "pnpm --filter @owd/marketing deploy:dry-run",
    "deploy:manual": "pnpm deploy",
    "dev": "pnpm build:web && wrangler dev",
    "dev:marketing": "pnpm --filter @owd/marketing dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings --ignore-pattern 'packages/obsidian-plugin/vendor/**' .",
    "package:plugin": "pnpm --filter @owd/obsidian-plugin package",
    "policy:check": "node scripts/check-repository-policy.mjs",
    "public-source:check": "node scripts/check-public-source.mjs",
    "release:check": "pnpm package:plugin && node scripts/check-release-contract.mjs && node scripts/check-release-regressions.mjs",
    "release:hash": "node scripts/hash-release-artifacts.mjs",
    "test": "pnpm test:marketing && vitest run && pnpm --filter @owd/obsidian-plugin test",
    "test:marketing": "pnpm --filter @owd/marketing test",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:migrations": "vitest run apps/worker/test/migrations-*.test.ts",
    "typecheck": "tsc -b",
    "types": "wrangler types apps/worker/src/worker-configuration.d.ts && pnpm --filter @owd/marketing types",
    "types:check": "wrangler types apps/worker/src/worker-configuration.d.ts --check && pnpm --filter @owd/marketing types:check",
    "upstream:check": "node scripts/check-upstream-compatibility.mjs",
    "upstream:config:check": "node --test scripts/check-upstream-compatibility.test.mjs && node scripts/check-upstream-compatibility.mjs --validate"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "age-encryption": "0.3.0",
    "oxlint": "1.74.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  }
}
