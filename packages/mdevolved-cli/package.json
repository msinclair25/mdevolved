{
  "name": "mdevolved",
  "version": "0.1.0-alpha.3",
  "description": "MDevolved source-neutral Markdown folder sync client.",
  "license": "Apache-2.0",
  "homepage": "https://mdevolved.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msinclair25/mdevolved.git",
    "directory": "packages/mdevolved-cli"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "mdevolved": "dist/cli-entry.js"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@mdevolved/folder-adapter": "workspace:*",
    "@mdevolved/yaos-core": "workspace:*",
    "@types/node": "26.1.1",
    "esbuild": "0.25.5",
    "fake-indexeddb": "6.2.5",
    "y-indexeddb": "9.0.12",
    "y-partyserver": "2.2.0",
    "yjs": "13.6.32"
  }
}
