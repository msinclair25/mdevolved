{
  "name": "mdevolved",
  "version": "0.1.0-alpha.1",
  "description": "MDevolved source-neutral Markdown folder sync client.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "mdevolved": "dist/cli-entry.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/index.js",
    "./custody": "./dist/index.js",
    "./pairing": "./dist/index.js",
    "./runtime": "./dist/index.js"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@owd/folder-adapter": "workspace:*",
    "@owd/yaos-core": "workspace:*",
    "@types/node": "26.1.1",
    "esbuild": "0.25.5",
    "fake-indexeddb": "6.2.5",
    "y-indexeddb": "9.0.12",
    "y-partyserver": "2.1.2",
    "yjs": "13.6.29"
  }
}
