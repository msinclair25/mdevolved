{
  "name": "@mdevolved/obsidian-plugin",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "The canonical MDevolved Sync adapter for Obsidian; legacy owd-sync installs remain readable but are never migrated silently.",
  "license": "Apache-2.0 AND 0BSD",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production && node scripts/guard-production-bundles.mjs",
    "guard:bundles": "node scripts/guard-production-bundles.mjs",
    "package": "pnpm build && node scripts/package-release.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@mdevolved/yaos-core": "workspace:*",
    "fast-diff": "1.3.0",
    "fflate": "0.8.3",
    "js-yaml": "4.3.1",
    "partyserver": "0.3.2",
    "y-codemirror.next": "0.3.5",
    "y-indexeddb": "9.0.12",
    "y-partyserver": "2.1.2",
    "yjs": "13.6.29"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@mdevolved/folder-adapter": "workspace:*",
    "esbuild": "0.25.5",
    "obsidian": "1.13.1",
    "tslib": "2.4.0"
  }
}
