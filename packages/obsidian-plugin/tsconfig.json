{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noImplicitOverride": false,
    "target": "ES2018",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vendor/yaos-src/**/*.ts"],
  "exclude": ["vendor/yaos-src/telemetry"]
}
