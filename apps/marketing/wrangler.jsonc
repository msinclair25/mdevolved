{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "md-evolved-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "mdevolved.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "send_email": [
    {
      "name": "ALPHA_ACCESS_EMAIL",
      "allowed_destination_addresses": ["support@mdevolved.com"],
      "allowed_sender_addresses": ["alpha@mdevolved.com"],
    },
  ],
  "ratelimits": [
    {
      "name": "ALPHA_ACCESS_RATE_LIMIT",
      "namespace_id": "1814571021",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
